[Unit]
Description=ADS-B Suite Server
After=network-online.target readsb.service
Wants=network-online.target

[Service]
Type=simple
User=adsbsuite
Group=adsbsuite
Environment=ADSB_SUITE_CONFIG=/etc/adsb-suite/config.json
WorkingDirectory=/opt/adsb-suite/server
ExecStart=/opt/adsb-suite/venv/bin/python /opt/adsb-suite/server/adsb_suite.py
Restart=always
RestartSec=5
# Webbeheer gebruikt uitsluitend de in sudoers toegestane admin-helper.
# NoNewPrivileges en ProtectSystem blokkeren anders sudo en systeemonderhoud.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=false
ProtectHome=true

[Install]
WantedBy=multi-user.target
