# ESP32-C3 LCDkit ADS-B memory tuning
# Six static RX buffers is the best compromise seen on this board: the previous
# default request for 10 could only allocate 6 once MQTT/LVGL were present, while
# 4 buffers proved marginal during retained MQTT traffic.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# This display is a station-only MQTT client.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
