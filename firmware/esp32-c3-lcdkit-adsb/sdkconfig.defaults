# ESP32-C3 LCDkit ADS-B memory tuning
# Keep Wi-Fi's static RX allocation small enough to coexist with LVGL/BSP and ESP-MQTT.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# This display is a station-only MQTT client; power-save remains enabled.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
